        "id" : "cashback-card",
        "title" : "2% Cashback Card"
      },
      {
        "badge" : "",
        "detail" : "Trip cancellation and lost-bag protection when you pay with Northwind.",
        "id" : "travel-cover",
        "title" : "Travel Cover"
      }
    ],
    "showSpringPromo" : true,
    "user" : {
      "firstName" : "there"
    }
  },
  "version" : "7148dfee87b9"
}